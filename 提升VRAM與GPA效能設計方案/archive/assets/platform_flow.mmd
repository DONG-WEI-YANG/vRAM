        W3 --> W4["DirectStorage API<br/>NVMe → GPU DMA"]
    end

    subgraph APP["AI 應用程式"]
        A1["PyTorch / Ollama<br/>看到 40GB VRAM"]
    end

    SD --> L1
    SD --> W1
    L4 --> A1
    W4 --> A1

